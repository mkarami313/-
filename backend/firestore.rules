rules_version = '2';

// Security rules for «همراهِ طیف» Firestore.
//
// Admin model: a user is admin when EITHER they have the custom auth claim admin==true,
// OR their users/{uid} document has isAdmin == true. The field path lets the project owner
// grant admin from the Firestore console (which bypasses these rules) without the Admin SDK.
// Regular users can never set their own isAdmin (create forces false; self-update forbids
// changing it), so only the console or an existing admin can promote someone.
//
// isAdmin() is placed LAST in every "||" so the extra document read only happens when the
// cheaper checks fail. REVIEWABLE DRAFT — test with the Emulator Suite before production.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isSelf(uid) { return isSignedIn() && request.auth.uid == uid; }
    function changedKeys() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true
        || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true)
      );
    }

    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSelf(uid)
        && request.resource.data.status == 'ACTIVE'
        && request.resource.data.isAdmin == false;
      allow update: if (isSelf(uid)
                        && request.resource.data.isAdmin == resource.data.isAdmin
                        && request.resource.data.status == resource.data.status)
                     || isAdmin();
      allow delete: if isSelf(uid) || isAdmin();
    }

    match /professionals/{uid} {
      allow read: if isSignedIn();
      allow create: if isSelf(uid)
        && request.resource.data.verificationStatus in ['NONE', 'PENDING'];
      allow update: if (isSelf(uid) && (
              request.resource.data.verificationStatus == resource.data.verificationStatus
              || request.resource.data.verificationStatus == 'PENDING'))
            || isAdmin();
      allow delete: if isSelf(uid) || isAdmin();
    }

    match /verifications/{id} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'PENDING';
      allow read: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow update: if isAdmin();
      allow delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    match /children/{id} {
      allow read, update, delete: if isSignedIn() && resource.data.familyUserId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.familyUserId == request.auth.uid;
    }

    match /questions/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if (isSignedIn() && resource.data.authorId == request.auth.uid)
        || (isSignedIn() && changedKeys().hasOnly(['helpfulCount', 'answerCount', 'updatedAt']))
        || isAdmin();
      allow delete: if (isSignedIn() && resource.data.authorId == request.auth.uid) || isAdmin();
    }

    match /answers/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if (isSignedIn() && resource.data.authorId == request.auth.uid)
        || (isSignedIn() && changedKeys().hasOnly(['helpfulByUserIds']))
        || isAdmin();
      allow delete: if (isSignedIn() && resource.data.authorId == request.auth.uid) || isAdmin();
    }

    match /groups/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if (isSignedIn() && resource.data.ownerId == request.auth.uid)
        || (isSignedIn() && changedKeys().hasOnly(['memberCount', 'updatedAt']))
        || isAdmin();
      allow delete: if (isSignedIn() && resource.data.ownerId == request.auth.uid) || isAdmin();
    }

    match /memberships/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn();
    }

    match /posts/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if (isSignedIn() && resource.data.authorId == request.auth.uid) || isAdmin();
    }

    match /conversations/{id} {
      allow read, update: if isSignedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participantIds;
    }
    match /messages/{id} {
      allow read: if isSignedIn()
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(resource.data.conversationId)).data.participantIds;
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.senderId
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)).data.participantIds;
    }

    match /guides/{id} {
      allow read: if isSignedIn();
      allow update: if (isSignedIn() && changedKeys().hasOnly(['savedByUserIds'])) || isAdmin();
      allow create, delete: if isAdmin();
    }

    match /reports/{id} {
      allow create: if isSignedIn() && request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    match /notifications/{id} {
      allow read, update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
    }

    match /adminActions/{id} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }
  }
}
