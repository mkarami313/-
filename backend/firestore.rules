rules_version = '2';

// Security rules for «همراهِ طیف» Firestore.
//
// These match the client's Firebase repositories. They are a REVIEWABLE DRAFT: test with
// the Firebase Emulator Suite before production. Principles:
//   - Anyone signed in can read public profiles/content; users write only their own data.
//   - Private child data, professional credentials, reports and admin actions are not public.
//   - "Admin" is a custom auth claim (request.auth.token.admin == true), set server-side only.
//   - The verified badge (professionals.verificationStatus == 'VERIFIED') is admin-only; a user
//     may only move their own status to 'PENDING' (request review), never to VERIFIED.
//
// NOTE: a few actions touch aggregate counters on documents the actor does not own
// (joining a group bumps memberCount; answering bumps answerCount; marking helpful bumps
// helpfulCount). Those are allowed narrowly via affectedKeys().hasOnly(...). In production,
// move counters and cross-user notifications to Cloud Functions and tighten these further.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isSelf(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isAdmin() { return isSignedIn() && request.auth.token.admin == true; }
    function changedKeys() { return request.resource.data.diff(resource.data).affectedKeys(); }

    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSelf(uid)
        && request.resource.data.status == 'ACTIVE'
        && request.resource.data.isAdmin == false;
      // Owner may edit their profile but not their own status/isAdmin. Admin may change status.
      allow update: if (isSelf(uid)
                        && request.resource.data.isAdmin == resource.data.isAdmin
                        && request.resource.data.status == resource.data.status)
                     || isAdmin();
      allow delete: if isSelf(uid) || isAdmin();
    }

    match /professionals/{uid} {
      allow read: if isSignedIn();
      allow create: if isSelf(uid)
        && request.resource.data.verificationStatus in ['NONE', 'PENDING'];
      // Owner may edit public fields; may set status to PENDING (request review) but never to
      // VERIFIED/REJECTED. Only admins set the final verification status.
      allow update: if isAdmin()
        || (isSelf(uid) && (
              request.resource.data.verificationStatus == resource.data.verificationStatus
              || request.resource.data.verificationStatus == 'PENDING'));
      allow delete: if isSelf(uid) || isAdmin();
    }

    // Private verification dossier (credentials). Owner creates/reads own; admins decide.
    match /verifications/{id} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'PENDING';
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // Private child data — owner-only, never public.
    match /children/{id} {
      allow read, update, delete: if isSignedIn() && resource.data.familyUserId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.familyUserId == request.auth.uid;
    }

    match /questions/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      // Author/admin may edit; anyone signed in may only bump the aggregate counters.
      allow update: if isAdmin()
        || (isSignedIn() && resource.data.authorId == request.auth.uid)
        || (isSignedIn() && changedKeys().hasOnly(['helpfulCount', 'answerCount', 'updatedAt']));
      allow delete: if (isSignedIn() && resource.data.authorId == request.auth.uid) || isAdmin();
    }

    match /answers/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      // Author/admin may edit; anyone signed in may only toggle themselves in helpfulByUserIds.
      allow update: if isAdmin()
        || (isSignedIn() && resource.data.authorId == request.auth.uid)
        || (isSignedIn() && changedKeys().hasOnly(['helpfulByUserIds']));
      allow delete: if (isSignedIn() && resource.data.authorId == request.auth.uid) || isAdmin();
    }

    match /groups/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      // Owner/admin may edit; anyone signed in may only adjust the member counter/timestamp
      // (joining/leaving a group).
      allow update: if isAdmin()
        || (isSignedIn() && resource.data.ownerId == request.auth.uid)
        || (isSignedIn() && changedKeys().hasOnly(['memberCount', 'updatedAt']));
      allow delete: if (isSignedIn() && resource.data.ownerId == request.auth.uid) || isAdmin();
    }

    match /memberships/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // Approvals/removals are done by group managers; kept broad for v1 (tighten with Functions).
      allow update, delete: if isSignedIn();
    }

    match /posts/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if (isSignedIn() && resource.data.authorId == request.auth.uid) || isAdmin();
    }

    match /conversations/{id} {
      allow read, update: if isSignedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participantIds;
    }
    match /messages/{id} {
      allow read: if isSignedIn()
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(resource.data.conversationId)).data.participantIds;
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.senderId
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)).data.participantIds;
    }

    match /guides/{id} {
      allow read: if isSignedIn();
      // Anyone signed in may only toggle themselves in savedByUserIds; admins author/edit.
      allow update: if isAdmin()
        || (isSignedIn() && changedKeys().hasOnly(['savedByUserIds']));
      allow create, delete: if isAdmin();
    }

    // Reports — any signed-in user may create; only admins may read/resolve.
    match /reports/{id} {
      allow create: if isSignedIn() && request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    // Notifications — readable/updatable/deletable by their owner. Creatable by any signed-in
    // user (client writes cross-user notifications in v1). Move to Cloud Functions for
    // stricter control in production.
    match /notifications/{id} {
      allow read, update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
    }

    // Admin audit log — admin-only, append-only.
    match /adminActions/{id} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }
  }
}
